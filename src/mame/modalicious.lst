    deliberately excluded so the UI shows only these five titles.
*******************************************************************************/

@source:pacman/pac4eva.cpp
pac4eva          // Pac-Man 4 EVA

@source:capcom/cps2.cpp
xmvsf2v2         // X-Men vs Street Fighter 2v2
mshvsf2v2        // Marvel Super Heroes vs Street Fighter 2v2
mvsc2v2          // Marvel vs Capcom 2v2
mvscduo          // Marvel vs Capcom Widescreen Duo-Mode
